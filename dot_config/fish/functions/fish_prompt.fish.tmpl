# The prompt is built from small segment functions (_prompt_*), each of which
# prints its own colors and resets them afterwards. Layout:
#
#   host:[dir:branch !status]
#
# The host segment is controlled by the prompthost option in .chezmoidata.toml.
# Root gets a red/magenta frame and no git info. Users in wheel/sudo get
# blue/green; users in neither get a dimmed gray/white frame.
function fish_prompt
    # Must be captured first; any other command overwrites $status.
    set -l last_status $status

    # A process's groups are fixed at startup, so check once per shell instead
    # of on every prompt. Without wheel/sudo the user can't escalate.
    if not set -q __prompt_unprivileged
        set -g __prompt_unprivileged true
        for group in (string split ' ' (id -Gn))
            if contains -- $group wheel sudo
                set __prompt_unprivileged false
                break
            end
        end
    end

    set -l frame_color blue
    set -l path_color green
    set -l is_root false
    if test $EUID -eq 0
        set frame_color red
        set path_color magenta
        set is_root true
    else if $__prompt_unprivileged
        set frame_color brblack
        set path_color white
    end

    {{ if .prompthost }}
    _prompt_host
    {{ end }}

    set_color $frame_color
    echo -n '['
    set_color $path_color
    echo -n (prompt_pwd)
    set_color normal

    # Root shouldn't be poking at git repositories.
    $is_root; or _prompt_git

    _prompt_status $last_status

    set_color $frame_color
    echo -n '] '
    set_color normal
end
