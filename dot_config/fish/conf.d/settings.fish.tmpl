# vim: ft=fish
function basic_settings
    # Shared with zsh, see .chezmoitemplates/shellenv
    {{ includeTemplate "shellenv" (merge (dict "syntax" "fish") .) | trim | indent 4 | trim }}

    # Sets wget to keep history in .local/state
    alias wget "wget --hsts-file $XDG_STATE_HOME/wget-hsts"

    bind \cq backward-kill-bigword

    set -g fish_autosuggestion_enabled 0

    fish_add_path ~/.local/bin
end
