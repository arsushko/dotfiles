{{- $k := includeTemplate "dirkeys.json" . | fromJson -}}
bind q mixer close
bind 0 mixer control_set_100
bind {{ $k.left }} textbox left
bind {{ $k.down }} textbox down
bind {{ $k.up }} textbox up
bind {{ $k.right }} textbox right

bind {{ $k.down }} mixer control_down_5
bind {{ $k.up }} mixer control_up_5

bind {{ $k.left }} mixer previous
bind {{ $k.right }} mixer next

{{ if (eq .colemak true) -}}
bind l mixer select_card
{{- else -}}
bind i mixer select_card
{{- end }}
color menu white black bold
color menu_selected white black reverse
