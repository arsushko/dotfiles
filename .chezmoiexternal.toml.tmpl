# vim: ft=toml
{{ if (eq .fonts true) }}
[".local/share/fonts/code-new-roman"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.0.2/CodeNewRoman.tar.xz"
    exact = true
[".local/share/fonts/cantarell"]
    type = "archive"
    url = "https://www.1001fonts.com/download/cantarell.zip"
    exact = true
[".local/share/fonts/0xproto"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.1.1/0xProto.tar.xz"
    exact = true
{{ end }}
{{ if (eq .tmuxplugins true) }}
# Pinned to v0.1.0: later releases renamed the options used in tmux.conf
[".config/tmux/plugins/catppuccin"]
    type = "archive"
    url = "https://github.com/catppuccin/tmux/archive/refs/tags/v0.1.0.tar.gz"
    checksum.sha256 = "7e4aa922ecf6554472cf7dbea7863f5e927d425ada05ae22611f4c854c0a6fef"
    stripComponents = 1
    exact = true
{{ end }}
